<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de la pantalla de ubicación GPS -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".LocationGpsActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/txt_titulo_gps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_gps"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Aquí se muestra la instrucción y después la latitud y longitud -->
    <TextView
        android:id="@+id/txt_ubicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/gps_instruccion"
        android:textSize="20sp" />

    <!-- Botón para obtener la ubicación -->
    <Button
        android:id="@+id/btn_gpscalcular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/boton_obtener_ubicacion" />

    <!-- Botón para regresar a MainActivity -->
    <Button
        android:id="@+id/btn_regresar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/boton_volver" />

</LinearLayout>
