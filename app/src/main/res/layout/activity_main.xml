<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de la pantalla principal: los elementos se colocan uno debajo de otro -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_principal"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Imagen (se encuentra en res/drawable) -->
    <ImageView
        android:id="@+id/imgContacto"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/descripcion_imagen"
        android:src="@drawable/contacto" />

    <!-- Texto descriptivo -->
    <TextView
        android:id="@+id/txtDescripcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/descripcion"
        android:textSize="16sp" />

    <!-- Botón que abre la segunda pantalla -->
    <Button
        android:id="@+id/btnVerContacto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/boton_ver_contacto" />

    <!-- Botón que abre la pantalla de ubicación GPS -->
    <Button
        android:id="@+id/btnVerUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/boton_ver_ubicacion" />

</LinearLayout>
